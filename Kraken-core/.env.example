# =============================================================================
# KRAKEN environment configuration example.
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored and must NEVER be committed.
#
# All values below are placeholders. None are real secrets.
# =============================================================================

# Application environment: local | development | staging | production
KRAKEN_ENV=local

# Logging level: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
KRAKEN_LOG_LEVEL=INFO

# Directory where log files are written (created if it does not exist)
KRAKEN_LOG_DIR=logs

# Whether to also write logs to a file in addition to the console
# Accepted values: true | false
KRAKEN_LOG_TO_FILE=false
